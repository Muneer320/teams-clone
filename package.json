{
    "name": "teamsclone-rl",
    "version": "1.0.0",
    "description": "A High-Fidelity Microsoft Teams Environment for Reinforcement Learning",
    "scripts": {
        "install:all": "npm run install:backend && npm run install:frontend",
        "install:backend": "npm --prefix backend ci",
        "install:frontend": "npm --prefix frontend ci",
        "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
        "dev:backend": "cd backend && npm run dev",
        "dev:frontend": "cd frontend && npm run dev",
        "start:backend": "cd backend && npm start",
        "start:frontend": "cd frontend && npm run dev",
        "build:frontend": "cd frontend && npm run build",
        "test": "npm --prefix backend test",
        "demo": "python rl_demo/run_demo.py"
    },
    "keywords": [
        "reinforcement-learning",
        "teams",
        "collaboration",
        "rl-environment",
        "hackathon"
    ],
    "author": "muneer320",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Muneer320/teams-clone.git"
    },
    "devDependencies": {
        "concurrently": "^8.2.0"
    },
    "dependencies": {}
}
